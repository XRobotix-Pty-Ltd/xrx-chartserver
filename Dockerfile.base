FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_VERSION=20
ENV PYTHON_VERSION=3.11

ARG PLANTUML_VERSION=1.2024.6

RUN apt-get update && apt-get install -y --no-install-recommends \
    # System tools
    curl ca-certificates gnupg \
    # Canvas / chart rendering native deps
    libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev librsvg2-dev \
    # Graphviz
    graphviz \
    # PlantUML — Java runtime (headless, minimal)
    default-jre-headless \
    # Supervisor (runs Python + Node in one container)
    supervisor \
    # Python
    python${PYTHON_VERSION} python${PYTHON_VERSION}-dev python3-pip python3-venv \
    # Node.js LTS
    && curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION}.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    # Make python3.11 the default python / python3
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python${PYTHON_VERSION} 1 \
    && update-alternatives --install /usr/bin/python  python  /usr/bin/python${PYTHON_VERSION} 1 \
    # PlantUML JAR (Apache 2.0 licensed since v1.2023.8)
    && mkdir -p /opt/plantuml \
    && curl -fsSL \
      "https://github.com/plantuml/plantuml/releases/download/v${PLANTUML_VERSION}/plantuml-${PLANTUML_VERSION}.jar" \
      -o /opt/plantuml/plantuml.jar

WORKDIR /app
